{
  "name": "crif-export",
  "version": "0.1.0",
  "private": true,
  "description": "Convert NBFC customer data from Excel into CRIF Highmark bureau submission files (Consumer UCRF-12, Commercial UCRF, MFI CDF).",
  "type": "module",
  "bin": {
    "crif-export": "./packages/cli/dist/index.js"
  },
  "scripts": {
    "build": "tsc -b",
    "cli": "tsx packages/cli/src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "web:dev": "vite --config packages/web/vite.config.ts",
    "web:build": "vite build --config packages/web/vite.config.ts",
    "make:templates": "tsx scripts/make-templates.ts"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "exceljs": "^4.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
