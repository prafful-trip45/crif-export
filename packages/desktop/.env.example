# Copy to .env and fill in. Baked into the build at compile time.

# Base URL of the auth/session backend serving /api/crif/* (login, heartbeat, refresh,
# logout) + the version gate. Enforces one active session per user, bound to the device.
#   - crif-auth Cloudflare Worker in this repo (packages/auth-worker):
#       dev:  http://127.0.0.1:8787       (npx wrangler dev)
#       prod: https://<your-auth-worker-domain>
#   - or the Vidyasetu backend if you wire the same routes there: https://api.vidyasetu.net
# Leave blank to run the app with NO login/gating (local dev only).
VITE_LICENSE_SERVER_URL=
