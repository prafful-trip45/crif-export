# Copy to .env and fill in. Baked into the build at compile time.

# Base URL of the auth/session backend serving /api/crif/* (login, session check, refresh,
# logout) + the version gate. Enforces one active session per user.
#   - PRODUCTION: the Vidyasetu backend (EduBridge-TS `/api/crif` routes, Cloud Run):
#       https://api.vidyasetu.net
#   - legacy: the crif-auth Cloudflare Worker (packages/auth-worker) — RETIRED; its
#     Workers-KV free tier (1,000 writes/day) capped out and silently disabled Generate.
# Leave blank to run the app with NO login/gating (local dev only).
VITE_LICENSE_SERVER_URL=https://api.vidyasetu.net
