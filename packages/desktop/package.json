{
  "name": "crif-export-desktop",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "CRIF Export — native desktop app (macOS + Windows). Excel → CRIF Highmark bureau submission files. Runs the same core engine the CLI/web use, entirely on-device.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "installers": "bash scripts/build-installers.sh",
    "installers:reinstall": "bash scripts/build-installers.sh --reinstall",
    "installers:ci": "bash scripts/build-installers.sh --print-ci",
    "icons": "tauri icon icons/source.png",
    "keygen": "node scripts/gen-attestation-key.mjs",
    "version:set": "node scripts/bump-version.mjs",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-dialog": "^2.2.0",
    "@tauri-apps/plugin-fs": "^2.2.0",
    "buffer": "^6.0.3",
    "exceljs": "^4.4.0",
    "process": "^0.11.10",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-node-polyfills": "^0.22.0"
  }
}
