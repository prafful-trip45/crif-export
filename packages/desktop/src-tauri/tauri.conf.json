{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CIC Converter (Gated)",
  "version": "0.2.10",
  "identifier": "net.vidyasetu.cic.gated",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CIC - Text and TUDF converter",
        "width": 980,
        "height": 840,
        "minWidth": 720,
        "minHeight": 600,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Business",
    "shortDescription": "Excel → CRIF Highmark bureau files",
    "longDescription": "Convert NBFC customer data in Excel into CRIF Highmark bureau submission files (Consumer UCRF-12, Commercial UCRF, MFI CDF). All processing happens on-device; no data leaves your machine.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "© 2026 crif-export",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
