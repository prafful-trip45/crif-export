{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "crif-auth",
	"main": "src/index.ts",
	"compatibility_date": "2026-06-01",
	// WebCrypto (SubtleCrypto) only — no nodejs_compat needed.
	"observability": {
		"enabled": true
	},
	// D1 holds the user table (provisioned accounts). Create with:
	//   npx wrangler d1 create crif-auth
	// then paste the returned database_id below.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "crif-auth",
			"database_id": "4730d90e-e26a-4c8f-bd0b-a933ec42be61",
			"remote": true
		}
	],
	// KV holds the ONE active session per user (key `sess:{userId}`). Create with:
	//   npx wrangler kv namespace create SESSIONS
	// then paste the returned id below.
	"kv_namespaces": [
		{
			"binding": "SESSIONS",
			"id": "2998e1bf7ba0418bbd5b44fd0178e80f",
			"remote": true
		}
	],
	"vars": {
		"MIN_VERSION": "0.1.0",
		"LATEST_VERSION": "0.2.1",
		"DOWNLOAD_URL": "https://cic.vidyasetu.net/download",
		// Access token: 1 DAY. Long on purpose — it cuts /refresh round-trips to ~1/day
		// per user instead of one every 15 min. This does NOT weaken single-session
		// enforcement: an evicted device is caught by the HEARTBEAT (`checkSession`
		// compares the token's `sid` to the stored one), not by token expiry — so a
		// still-valid-but-evicted token is rejected on its next heartbeat regardless.
		"ACCESS_TTL_SECONDS": "86400",
		// Refresh token: 30 days, rotated single-use on every /refresh.
		"REFRESH_TTL_SECONDS": "2592000"
	}
	// Secret (NOT in this file):  npx wrangler secret put JWT_SECRET
	// A custom domain route (e.g. api.vidyasetu.net) is added the same way the
	// conversion worker pins cic.vidyasetu.net.
}